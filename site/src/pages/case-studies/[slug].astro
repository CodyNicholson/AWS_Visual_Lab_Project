---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExamTags from '../../components/ExamTags.astro';
import VerifiedBadge from '../../components/VerifiedBadge.astro';

export async function getStaticPaths() {
  return (await getCollection('caseStudies')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'caseStudies'> };
const { Content } = await render(entry);
const d = entry.data;
---

<BaseLayout title={d.title} description={d.summary} searchable>
  <h1 class="text-3xl font-bold tracking-tight">{d.title}</h1>
  <p class="mt-2 text-lg text-slate-600 dark:text-slate-300">{d.summary}</p>
  <div class="mt-3 flex flex-wrap items-center gap-3">
    <ExamTags exams={d.exams} examDomains={d.exam_domains} />
    <VerifiedBadge date={d.last_verified} />
  </div>
  <article class="prose prose-slate mt-8 max-w-none dark:prose-invert"><Content /></article>
</BaseLayout>
