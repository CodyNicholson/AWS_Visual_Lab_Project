---
// Pagefind UI. The index is generated by `pagefind --site dist` after `astro build`,
// so search only works on a built site (npm run build && npm run preview), not in `astro dev`.
interface Props {
  autofocus?: boolean;
}
const { autofocus = false } = Astro.props;
---

<div id="search" class="pagefind-host" data-autofocus={autofocus ? 'true' : undefined}>
  <noscript>Search needs JavaScript. Browse by <a href="/concepts/">service</a> or <a href="/exams/">exam</a> instead.</noscript>
</div>

<script>
  const host = document.getElementById('search')!;
  const css = document.createElement('link');
  css.rel = 'stylesheet';
  css.href = '/pagefind/pagefind-ui.css';
  document.head.append(css);
  const s = document.createElement('script');
  s.src = '/pagefind/pagefind-ui.js';
  s.onload = () => {
    // @ts-expect-error PagefindUI is a global from the script above
    new PagefindUI({ element: '#search', showSubResults: true, showImages: false, autofocus: host.dataset.autofocus === 'true' });
  };
  s.onerror = () => {
    host.innerHTML = '<p class="text-sm text-slate-500">Search index not found. It is built by <code>npm run build</code>.</p>';
  };
  document.head.append(s);
</script>

<style is:global>
  .pagefind-host {
    --pagefind-ui-primary: #c2410c;
    --pagefind-ui-border-radius: 8px;
    --pagefind-ui-font: inherit;
  }
  .dark .pagefind-host {
    --pagefind-ui-primary: #fdba74;
    --pagefind-ui-text: #e2e8f0;
    --pagefind-ui-background: #111a2c;
    --pagefind-ui-border: #1b2740;
    --pagefind-ui-tag: #1b2740;
  }
</style>
