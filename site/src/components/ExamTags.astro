---
interface Props {
  exams: string[];
  examDomains?: string[];
  tasks?: string[];
}
const { exams, examDomains = [], tasks = [] } = Astro.props;
// "DVA-C03-D1" -> "DVA-C03 domain 1"
const domainLabel = (id: string) => id.replace(/-D(\d)$/, ' domain $1');
const tagged = new Set(examDomains.map((d) => d.replace(/-D\d$/, '')));
const examOnly = exams.filter((e) => !tagged.has(e));
---

<ul class="flex flex-wrap gap-2" aria-label="Exam tags">
  {
    examDomains.map((d) => (
      <li class="rounded-full bg-brand-50 px-2.5 py-0.5 text-xs font-medium text-brand-700 dark:bg-brand-700/20 dark:text-brand-300">
        {domainLabel(d)}
      </li>
    ))
  }
  {
    examOnly.map((e) => (
      <li class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-700 dark:bg-slate-800 dark:text-slate-300">{e}</li>
    ))
  }
  {
    tasks.map((t) => (
      <li class="rounded-full border border-slate-300 px-2.5 py-0.5 font-mono text-xs dark:border-slate-700">{t.replace(/^[A-Z]{3}-C\d{2}-/, 'Task ')}</li>
    ))
  }
</ul>
