# Copy to .env (git-ignored) and fill in. pipeline-run.sh creates .env from this file when it is
# missing. Never put a real value in this file: it is committed to a public repository.

# Optional: only used by pipeline-run.sh when TUNNEL_TOKEN is not set globally on the server
TUNNEL_TOKEN=

# Host port for the UI, bound to 127.0.0.1 only (the tunnel doesn't need it; it reaches the
# container over tunnel-net). Leave empty to let Docker pick a free localhost port.
FRONTEND_HOST_PORT=

# Host port for the isolated test stack (docker-compose.test.yml), also localhost only.
# Leave empty to let Docker pick a free port (docker ps shows it).
TEST_UI_PORT=
